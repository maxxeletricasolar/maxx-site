# MAXX Elétrica Solar — site estático na Hostinger
Options -Indexes
ErrorDocument 404 /404.html

# Nunca servir o repositório nem arquivos de trabalho (.git, .env, backups, logs, dumps, markdown)
RedirectMatch 404 /\.git
<FilesMatch "(^\.(?!well-known)|\.(bak|log|sql|md|env|old|orig|swp)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
# www -> domínio principal (o HTTPS obrigatório fica ligado no painel da Hostinger, por causa da CDN)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/webp .webp
AddCharset utf-8 .html .css .js .json .txt .xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType application/json "access plus 1 day"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json text/plain text/xml application/xml image/svg+xml
</IfModule>

# Headers de segurança
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
# HSTS só vale se o HTTPS estiver ativo no painel da Hostinger (sem includeSubDomains de propósito)
Header always set Strict-Transport-Security "max-age=15552000"
# CSP em modo Report-Only: não bloqueia nada, só avisa no console (F12) do navegador.
# Depois de navegar o site inteiro sem avisos, troque por Content-Security-Policy.
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com https://connect.facebook.net; frame-src https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me https://api.whatsapp.com"
</IfModule>
